{
  "name": "@zakkster/lite-bvh",
  "version": "1.0.0",
  "description": "Zero-GC dynamic Bounding Volume Hierarchy for 2D. Flat Structure-of-Arrays layout, O(1) free-list allocation, SAH insertion, iterative query — every operation is allocation-free after construction. Companion to @zakkster/lite-aabb.",
  "type": "module",
  "main": "./Bvh.js",
  "module": "./Bvh.js",
  "types": "./Bvh.d.ts",
  "exports": {
    ".": {
      "types": "./Bvh.d.ts",
      "node": "./Bvh.js",
      "import": "./Bvh.js",
      "default": "./Bvh.js"
    }
  },
  "files": [
    "Bvh.js",
    "Bvh.d.ts",
    "README.md",
    "llms.txt",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --expose-gc test/Bvh.test.js"
  },
  "keywords": [
    "bvh",
    "bounding-volume-hierarchy",
    "spatial-index",
    "broadphase",
    "collision",
    "aabb",
    "dynamic-tree",
    "box2d",
    "sah",
    "surface-area-heuristic",
    "2d",
    "physics",
    "zero-gc",
    "allocation-free",
    "structure-of-arrays",
    "typed-array",
    "twitch-extension",
    "canvas",
    "webgl",
    "game-dev",
    "particles",
    "tilemap"
  ],
